[Unit]
Description=NullWave Audio Stream Proxy Server
After=network.target network-online.target
Wants=network-online.target
StartLimitIntervalSec=0

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/Thenullwave-Worker
ExecStart=/home/ubuntu/Thenullwave-Worker/venv/bin/gunicorn --bind 0.0.0.0:4000 --workers 1 --threads 4 --worker-class gthread --timeout 60 --max-requests 250 --max-requests-jitter 25 app:app
Restart=always
RestartSec=3
KillMode=mixed
TimeoutStopSec=10
# Protect 500MB RAM VM from runaway memory
MemoryMax=450M

[Install]
WantedBy=multi-user.target
