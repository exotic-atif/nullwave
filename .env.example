VITE_SUPABASE_URL=your_supabase_url
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key
VITE_CLOUDINARY_CLOUD_NAME=mian-storage
VITE_CLOUDINARY_API_KEY=your_api_key_here
VITE_API_URL=http://localhost:8787

# Primary Stream Server (Your Oracle VM proxy with HTTPS via DuckDNS + Caddy)
VITE_STREAM_API_URL=https://thenullwave.duckdns.org

# Fallback Stream Server (Backup / Render - used automatically if Oracle VM is high on load or offline)
VITE_FALLBACK_STREAM_API_URL=https://nullwave.onrender.com

# Firebase Client Configuration (Atif's Codeworks)
VITE_FIREBASE_API_KEY=your_firebase_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
VITE_FIREBASE_APP_ID=your_app_id
